{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://guaji.example/schemas/mod/v1/dialogue.schema.json",
  "title": "dialogue definition v1",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "text"
  ],
  "properties": {
    "text": {
      "type": "string",
      "minLength": 1
    },
    "scenes": {
      "type": "array"
    },
    "states": {
      "type": "array"
    },
    "member_ids": {
      "type": "array"
    },
    "visual_ids": {
      "type": "array"
    },
    "trait_ids_any": {
      "type": "array"
    },
    "min_level": {
      "type": "integer"
    },
    "max_level": {
      "type": "integer"
    },
    "weight": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "cooldown_seconds": {
      "type": "number",
      "minimum": 0
    },
    "custom_conditions": {
      "type": "array"
    }
  }
}
