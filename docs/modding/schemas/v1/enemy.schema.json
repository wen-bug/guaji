{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://guaji.example/schemas/mod/v1/enemy.schema.json",
  "title": "enemy definition v1",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "name",
    "visual_id",
    "scene_path"
  ],
  "properties": {
    "name": {
      "type": "string"
    },
    "visual_id": {
      "type": "string"
    },
    "scene_path": {
      "type": "string"
    },
    "skills": {
      "type": "array"
    },
    "drops": {
      "type": "object"
    },
    "encounter_class": {
      "enum": [
        "normal",
        "elite",
        "boss"
      ]
    },
    "enemy_class": {
      "enum": [
        "normal",
        "elite",
        "boss"
      ]
    },
    "reference_stat_multipliers": {
      "type": "object",
      "additionalProperties": {
        "type": "number",
        "minimum": 0
      }
    },
    "experience_multiplier": {
      "type": "number",
      "minimum": 0
    },
    "drop_chance_bonus": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "equipment_drop_chance": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "use_rank_drop_pool": {
      "type": "boolean"
    },
    "skill_unlock_rank": {
      "enum": [
        "t1",
        "t2",
        "t3",
        "t4",
        "t5"
      ]
    }
  }
}
