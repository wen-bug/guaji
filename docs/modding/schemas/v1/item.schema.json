{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://guaji.example/schemas/mod/v1/item.schema.json",
  "title": "item definition v1",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "name",
    "type"
  ],
  "properties": {
    "name": {
      "type": "string"
    },
    "type": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "stackable": {
      "type": "boolean"
    },
    "usable": {
      "type": "boolean"
    },
    "payload": {
      "type": "object"
    },
    "icon_path": {
      "type": "string"
    }
  }
}
