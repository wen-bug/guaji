{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://guaji.example/schemas/mod/v1/skill.schema.json",
  "title": "skill definition v1",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "name",
    "scene_path",
    "target_scope",
    "target_mode"
  ],
  "properties": {
    "name": {
      "type": "string"
    },
    "scene_path": {
      "type": "string"
    },
    "type": {
      "type": "string"
    },
    "target_scope": {
      "enum": [
        "self",
        "single_ally",
        "all_allies",
        "single_enemy",
        "all_enemies"
      ]
    },
    "mp_cost": {
      "type": "number",
      "minimum": 0
    },
    "cooldown": {
      "type": "number",
      "minimum": 0
    },
    "release_distance": {
      "type": "number",
      "minimum": 0,
      "deprecated": true,
      "description": "Legacy field accepted for compatibility and ignored by runtime."
    },
    "effects": {
      "type": "array"
    },
    "target_mode": {
      "enum": [
        "single",
        "aoe"
      ]
    }
  }
}
