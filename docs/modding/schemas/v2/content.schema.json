{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://guaji.example/schemas/mod/v2/content.schema.json",
  "title": "Guaji Mod Content Envelope v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "entries"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "kind": {
      "enum": [
        "item",
        "equipment",
        "skill",
        "basic_attack",
        "recipe",
        "trait",
        "enemy",
        "enemy_rank",
        "drop_table",
        "appearance",
        "dialogue"
      ]
    },
    "entries": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "operation",
              "local_id",
              "data"
            ],
            "properties": {
              "operation": {
                "const": "add"
              },
              "local_id": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
              },
              "data": {
                "type": "object"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "operation",
              "target_id",
              "patch"
            ],
            "properties": {
              "operation": {
                "const": "patch"
              },
              "target_id": {
                "type": "string",
                "minLength": 1
              },
              "patch": {
                "type": "object"
              }
            }
          }
        ]
      }
    }
  }
}
