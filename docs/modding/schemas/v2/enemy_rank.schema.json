{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://guaji.example/schemas/mod/v2/enemy_rank.schema.json",
  "title": "enemy_rank definition v2",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "name"
  ],
  "properties": {
    "name": {
      "type": "string"
    },
    "min_level": {
      "type": "integer",
      "minimum": 1
    },
    "max_level": {
      "type": "integer",
      "minimum": 0
    },
    "skill_count": {
      "type": "integer",
      "minimum": 0
    }
  }
}
