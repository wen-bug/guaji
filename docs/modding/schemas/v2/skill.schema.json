{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://guaji.example/schemas/mod/v2/skill.schema.json",
  "title": "skill definition v2",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "scene_path"
  ],
  "properties": {
    "name": {
      "type": "string"
    },
    "scene_path": {
      "type": "string"
    },
    "type": {
      "enum": ["normal_attack", "damage", "heal", "buff", "defense", "resource"]
    },
    "target_scope": {
      "enum": [
        "self",
        "single_ally",
        "all_allies",
        "single_enemy",
        "all_enemies"
      ]
    },
    "mp_cost": {
      "type": "number",
      "minimum": 0
    },
    "cooldown": {
      "type": "number",
      "minimum": 0
    },
    "effects": {
      "type": "array",
      "items": {"$ref": "#/$defs/effect"}
    },
    "target_mode": {
      "enum": [
        "single",
        "aoe"
      ]
    }
  },
  "$defs": {
    "effect": {
      "type": "object",
      "required": ["kind"],
      "properties": {
        "effect_id": {"type": "string"},
        "kind": {"type": "string", "minLength": 1},
        "target": {"enum": ["skill_targets", "caster", "primary_target", "hit_targets"]},
        "impact_id": {"type": "string", "minLength": 1},
        "base_amount": {"type": "integer"},
        "attribute_multiplier": {"type": "number", "minimum": 0},
        "status_id": {"type": "string"},
        "status_kind": {"enum": ["dot", "hot", "shield", "buff_stat", "debuff_stat"]},
        "duration_turns": {"type": "integer", "minimum": 1},
        "stack_mode": {"enum": ["refresh", "stack"]},
        "max_stacks": {"type": "integer", "minimum": 1},
        "status_scene_path": {"type": "string", "minLength": 1}
      },
      "allOf": [
        {
          "if": {"properties": {"kind": {"const": "status"}}, "required": ["kind"]},
          "then": {
            "required": ["status_id", "status_kind", "duration_turns", "status_scene_path"],
            "properties": {"status_id": {"minLength": 1}}
          }
        }
      ]
    }
  }
}
