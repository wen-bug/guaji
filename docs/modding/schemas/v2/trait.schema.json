{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://guaji.example/schemas/mod/v2/trait.schema.json",
  "title": "trait definition v2",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "name"
  ],
  "anyOf": [
    { "required": ["effects"] },
    { "required": ["effects_by_rarity"] }
  ],
  "properties": {
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "effects": {
      "type": "array"
    },
    "effects_by_rarity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "common": { "type": "array" },
        "rare": { "type": "array" },
        "exceptional": { "type": "array" }
      }
    }
  }
}
