{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://guaji.example/schemas/mod/v2/recipe.schema.json",
  "title": "recipe definition v2",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "result_item_id",
    "materials"
  ],
  "properties": {
    "result_item_id": {
      "type": "string"
    },
    "materials": {
      "type": "array"
    },
    "unlock_building_level": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10
    }
  }
}
