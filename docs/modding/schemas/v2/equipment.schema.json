{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://guaji.example/schemas/mod/v2/equipment.schema.json",
  "title": "equipment definition v2",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "name",
    "slot"
  ],
  "properties": {
    "name": {
      "type": "string"
    },
    "slot": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "description_effects": {
      "type": "array"
    },
    "tier_base_attributes": {
      "type": "object",
      "properties": {
        "t1": {"$ref": "#/$defs/attributeList"},
        "t2": {"$ref": "#/$defs/attributeList"},
        "t3": {"$ref": "#/$defs/attributeList"},
        "t4": {"$ref": "#/$defs/attributeList"},
        "t5": {"$ref": "#/$defs/attributeList"}
      },
      "additionalProperties": false
    },
    "icon_path": {
      "type": "string"
    }
  },
  "$defs": {
    "attributeList": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["stat", "amount"],
        "properties": {
          "stat": {"type": "string"},
          "amount": {"type": "integer"}
        },
        "additionalProperties": false
      }
    }
  }
}
