{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://guaji.example/schemas/mod/v2/basic_attack.schema.json",
  "title": "basic_attack definition v2",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "name",
    "effects"
  ],
  "properties": {
    "name": {
      "type": "string"
    },
    "target_scope": {
      "enum": ["self", "single_ally", "all_allies", "single_enemy", "all_enemies"]
    },
    "target_mode": {
      "enum": ["single", "aoe"]
    },
    "effects": {
      "type": "array",
      "items": {"type": "object"}
    }
  }
}
