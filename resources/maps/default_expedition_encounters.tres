[gd_resource type="Resource" script_class="MapEncounterProfile" load_steps=7 format=3]

[ext_resource type="Script" path="res://scripts/map/encounters/map_enemy_class_pool.gd" id="1_pool"]
[ext_resource type="Script" path="res://scripts/map/encounters/map_encounter_variant.gd" id="2_variant"]
[ext_resource type="Script" path="res://scripts/map/encounters/map_encounter_profile.gd" id="3_profile"]

[sub_resource type="Resource" id="Resource_normal_pool"]
script = ExtResource("1_pool")
encounter_class = "normal"
weight = 1.0
enemy_ids = Array[String](["forest_wolf"])

[sub_resource type="Resource" id="Resource_random_variant"]
script = ExtResource("2_variant")
id = "forest_patrol"
weight = 1.0
class_pools = Array[Resource]([SubResource("Resource_normal_pool")])

[resource]
script = ExtResource("3_profile")
profile_id = "default_expedition"
fallback_enemy_id = "forest_wolf"
enemies_per_party_member = 2
min_enemy_count = 1
max_enemy_count = 8
variants = Array[Resource]([SubResource("Resource_random_variant")])
